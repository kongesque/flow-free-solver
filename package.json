{
  "name": "flow-free-solver",
  "version": "0.1.0",
  "description": "A React-based Flow Free puzzle solver featuring A* heuristics and client-side Z3 SAT solver integration.",
  "private": true,
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "z3-solver": "^4.16.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "watch:wasm": "node scripts/build-wasm.mjs --watch",
    "sync:wasm": "node scripts/sync-wasm-assets.mjs",
    "postinstall": "npm run sync:wasm",
    "predev": "npm run sync:wasm",
    "prestart": "npm run sync:wasm",
    "prebuild": "npm run sync:wasm",
    "build": "npm run typecheck && vite build",
    "build:all": "npm run build:wasm && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm": "npm run build:wasm && node --test tests/wasm/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run test:wasm && npm test && npm run build && npm run test:e2e"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "coi-serviceworker": "^0.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "@tailwindcss/vite": "^4.3.3"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
